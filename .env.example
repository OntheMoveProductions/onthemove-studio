# Copy this file to .env to change any of these. Everything is optional.
# (The Mac app doesn't use this file: it asks for GitHub details on first launch.)

# Port the editor runs on (open http://localhost:4500).
PORT=4500

# Leave empty when the editor only runs on your own computer: no login needed.
# Set a password if you run it on a server other people can reach, and also
# set HOST=0.0.0.0 so it accepts connections from other machines.
ADMIN_PASSWORD=
HOST=127.0.0.1

# Signs the login cookie when ADMIN_PASSWORD is set. Any long random string.
SESSION_SECRET=

# Publishing to GitHub Pages without signing in on this computer.
# GITHUB_REPO: the repository, as owner/name (e.g. OntheMoveProductions/onthemove).
# GITHUB_TOKEN: a fine-grained personal access token limited to that one
#   repository, with "Contents" and "Pages" set to Read and write.
#   (github.com → Settings → Developer settings → Personal access tokens.)
# Keep this file private: anyone with the token can change the website.
GITHUB_REPO=
GITHUB_TOKEN=

# Folder of the website being edited. Defaults to ../site next to this folder.
# SITE_ROOT=
